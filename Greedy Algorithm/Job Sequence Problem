class Solution {
    public int[] JobScheduling(int[][] jobs, int n) {
        // Sort jobs by profit in descending order
        Arrays.sort(jobs, (a, b) -> b[2] - a[2]);

        // Find maximum deadline
        int maxDeadline = 0;
        for (int i = 0; i < n; i++) {
            maxDeadline = Math.max(maxDeadline, jobs[i][1]);
        }

        // Slot array to check free time
        boolean[] slot = new boolean[maxDeadline + 1];

        int countJobs = 0;
        int maxProfit = 0;

        // Try to schedule each job
        for (int i = 0; i < n; i++) {
            int deadline = jobs[i][1];
            int profit = jobs[i][2];

            // Find a free slot from deadline backwards
            for (int j = deadline; j > 0; j--) {
                if (!slot[j]) {
                    slot[j] = true;
                    countJobs++;
                    maxProfit += profit;
                    break;
                }
            }
        }

        return new int[]{countJobs, maxProfit};
    }
}
