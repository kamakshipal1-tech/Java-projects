void solve(int idx, int[] nums, List<Integer> temp) {

    if (idx == nums.length) {
        ans.add(new ArrayList<>(temp));
        return;
    }

    // TAKE
    temp.add(nums[idx]);
    solve(idx + 1, nums, temp);
    temp.remove(temp.size() - 1);

    // NOT TAKE
    int i = idx + 1;
    while (i < nums.length && nums[i] == nums[idx]) {
        i++;
    }
    solve(i, nums, temp);
}
