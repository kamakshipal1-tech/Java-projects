class Solution {
    public ListNode middleNode(ListNode head) {

        if (head == null) return null;

        ListNode temp = head;
        int count = 0;

        // First pass: count nodes
        while (temp != null) {
            count++;
            temp = temp.next;
        }

        // Second pass: go to middle
        temp = head;
        int mid = count / 2;

        while (mid > 0) {
            temp = temp.next;
            mid--;
        }

        return temp;
    }
}
