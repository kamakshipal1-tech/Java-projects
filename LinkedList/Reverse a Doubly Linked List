Node reverseDLL(Node head) {
    if (head == null)
        return null;

    Node temp = null;
    Node curr = head;

    while (curr != null) {
        temp = curr.prev;
        curr.prev = curr.next;
        curr.next = temp;
        curr = curr.prev;   // move forward (because swapped)
    }

    if (temp != null)
        head = temp.prev;

    return head;
}
