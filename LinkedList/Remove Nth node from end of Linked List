class Solution {
    public ListNode removeNthFromEnd(ListNode head, int n) {

        if (head == null) return null;

        // Step 1: Find length
        int length = 0;
        ListNode temp = head;
        while (temp != null) {
            length++;
            temp = temp.next;
        }

        // Step 2: If head is to be removed
        if (n == length) {
            return head.next;
        }

        // Step 3: Go to (length - n - 1)th node
        temp = head;
        for (int i = 1; i < length - n; i++) {
            temp = temp.next;
        }

        // Step 4: Remove node
        temp.next = temp.next.next;

        return head;
    }
}
