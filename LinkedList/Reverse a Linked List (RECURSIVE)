class Solution {
    public ListNode reverseList(ListNode head) {

        // Base case
        if (head == null || head.next == null)
            return head;

        // Reverse rest of the list
        ListNode newHead = reverseList(head.next);

        // Fix current node
        head.next.next = head;
        head.next = null;

        return newHead;
    }
}
