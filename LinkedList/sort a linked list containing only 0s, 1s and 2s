class Solution {
    public ListNode sortList(ListNode head) {

        if (head == null || head.next == null)
            return head;

        int count0 = 0, count1 = 0, count2 = 0;
        ListNode temp = head;

        // Count
        while (temp != null) {
            if (temp.val == 0) count0++;
            else if (temp.val == 1) count1++;
            else count2++;
            temp = temp.next;
        }

        // Overwrite values
        temp = head;
        while (count0-- > 0) {
            temp.val = 0;
            temp = temp.next;
        }
        while (count1-- > 0) {
            temp.val = 1;
            temp = temp.next;
        }
        while (count2-- > 0) {
            temp.val = 2;
            temp = temp.next;
        }

        return head;
    }
}
