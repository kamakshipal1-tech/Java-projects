class Solution {
    public int minEatingSpeed(int[] piles, int h) {
        int beg = 1;
        int end = 0;

        for (int p : piles) {
            end = Math.max(end, p);
        }

        int ans = end;

        while (beg <= end) {
            int mid = beg + (end - beg) / 2;
            long hours = 0;

            for (int p : piles) {
                hours += (p + mid - 1) / mid; // ceil(p / mid)
            }

            if (hours <= h) {
                ans = mid;
                end = mid - 1;
            } else {
                beg = mid + 1;
            }
        }
        return ans;
    }
}
