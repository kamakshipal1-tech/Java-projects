class Solution {

    static class Node {
        Node[] child = new Node[2];
    }

    static class Trie {

        Node root = new Node();

        public void insert(int num) {

            Node node = root;

            for (int i = 31; i >= 0; i--) {

                int bit = (num >> i) & 1;

                if (node.child[bit] == null) {
                    node.child[bit] = new Node();
                }

                node = node.child[bit];
            }
        }

        public int getMax(int num) {

            Node node = root;
            int max = 0;

            for (int i = 31; i >= 0; i--) {

                int bit = (num >> i) & 1;

                int want = 1 - bit;

                if (node.child[want] != null) {
                    max = max | (1 << i);
                    node = node.child[want];
                } else {
                    node = node.child[bit];
                }
            }

            return max;
        }
    }

    public int findMaximumXOR(int[] nums) {

        Trie trie = new Trie();

        for (int x : nums) {
            trie.insert(x);
        }

        int ans = 0;

        for (int x : nums) {
            ans = Math.max(ans, trie.getMax(x));
        }

        return ans;
    }
}
