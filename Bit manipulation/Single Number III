class Solution {
    public int[] singleNumber(int[] nums) {

        int xorAll = 0;
        for (int n : nums) {
            xorAll ^= n;
        }

        // rightmost set bit
        int mask = xorAll & (-xorAll);

        int a = 0, b = 0;
        for (int n : nums) {
            if ((n & mask) != 0) {
                a ^= n;
            } else {
                b ^= n;
            }
        }

        return new int[]{a, b};
    }
}
